<UserControl x:Class="OpSecBar.Controls.MediaWidget"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- Equalizzatore animato: gira solo durante la riproduzione, a frame rate ridotto -->
        <Storyboard x:Key="EqStoryboard" RepeatBehavior="Forever" Timeline.DesiredFrameRate="24">
            <DoubleAnimation Storyboard.TargetName="Eq1" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                             From="0.25" To="1" Duration="0:0:0.42" AutoReverse="True" />
            <DoubleAnimation Storyboard.TargetName="Eq2" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                             From="1" To="0.3" Duration="0:0:0.33" AutoReverse="True" />
            <DoubleAnimation Storyboard.TargetName="Eq3" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                             From="0.4" To="0.95" Duration="0:0:0.51" AutoReverse="True" />
            <DoubleAnimation Storyboard.TargetName="Eq4" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                             From="0.8" To="0.2" Duration="0:0:0.38" AutoReverse="True" />
        </Storyboard>

        <Style x:Key="EqBar" TargetType="Rectangle">
            <Setter Property="Width" Value="2.5" />
            <Setter Property="Height" Value="12" />
            <Setter Property="RadiusX" Value="1.25" />
            <Setter Property="RadiusY" Value="1.25" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="Fill" Value="{DynamicResource AccentBrush}" />
            <Setter Property="RenderTransformOrigin" Value="0.5,1" />
        </Style>
    </UserControl.Resources>

    <Grid x:Name="RootGrid" Visibility="Collapsed">
        <!-- Vista compatta nella barra -->
        <StackPanel x:Name="Compact" Orientation="Horizontal">
            <Button x:Name="InfoButton" Style="{StaticResource BarButton}" Padding="5,0,7,0" Click="InfoButton_Click"
                    ToolTip="Expand player">
                <StackPanel x:Name="InfoPanel" Orientation="Horizontal">
                    <Grid x:Name="CoverHost" Width="22" Height="22">
                        <Border CornerRadius="5" Background="{DynamicResource HoverBrush}">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE8D6;" FontSize="11" />
                        </Border>
                        <Border x:Name="CoverSmall" CornerRadius="5" />
                    </Grid>
                    <TextBlock x:Name="CompactTitle" Margin="8,0,0,0" MaxWidth="190" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Button>
            <Button x:Name="PrevButton" Style="{StaticResource BarButton}" Padding="5,0" MinWidth="26" Click="Prev_Click" ToolTip="Previous">
                <TextBlock Style="{StaticResource Glyph}" Text="&#xE892;" FontSize="11" Foreground="{DynamicResource IconBrush}" />
            </Button>
            <Button x:Name="PlayButton" Style="{StaticResource BarButton}" Padding="5,0" MinWidth="26" Click="Play_Click" ToolTip="Play / Pause">
                <TextBlock x:Name="PlayGlyph" Style="{StaticResource Glyph}" Text="&#xE768;" FontSize="12" Foreground="{DynamicResource IconBrush}" />
            </Button>
            <Button x:Name="NextButton" Style="{StaticResource BarButton}" Padding="5,0" MinWidth="26" Click="Next_Click" ToolTip="Next">
                <TextBlock Style="{StaticResource Glyph}" Text="&#xE893;" FontSize="11" Foreground="{DynamicResource IconBrush}" />
            </Button>
            <StackPanel x:Name="Equalizer" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,6,0" Opacity="0.35">
                <Rectangle x:Name="Eq1" Style="{StaticResource EqBar}"><Rectangle.RenderTransform><ScaleTransform ScaleY="0.4" /></Rectangle.RenderTransform></Rectangle>
                <Rectangle x:Name="Eq2" Style="{StaticResource EqBar}"><Rectangle.RenderTransform><ScaleTransform ScaleY="0.8" /></Rectangle.RenderTransform></Rectangle>
                <Rectangle x:Name="Eq3" Style="{StaticResource EqBar}"><Rectangle.RenderTransform><ScaleTransform ScaleY="0.55" /></Rectangle.RenderTransform></Rectangle>
                <Rectangle x:Name="Eq4" Style="{StaticResource EqBar}"><Rectangle.RenderTransform><ScaleTransform ScaleY="0.3" /></Rectangle.RenderTransform></Rectangle>
            </StackPanel>
        </StackPanel>

        <!-- Vista espansa -->
        <Popup x:Name="Flyout" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade"
               PlacementTarget="{Binding ElementName=Compact}" Placement="Bottom" Opened="Flyout_Opened" Closed="Flyout_Closed">
            <Border Style="{StaticResource FlyoutBorder}" Width="320" Padding="16" TextElement.Foreground="{DynamicResource PanelFgBrush}"
                    TextElement.FontFamily="{DynamicResource BarFont}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid Width="84" Height="84">
                            <Border CornerRadius="10" Background="{DynamicResource PanelHoverBrush}">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE8D6;" FontSize="28" Foreground="{DynamicResource PanelFgDimBrush}" />
                            </Border>
                            <Border x:Name="CoverLarge" CornerRadius="10" />
                        </Grid>
                        <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="FlyoutTitle" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" MaxHeight="42"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="FlyoutArtist" FontSize="12.5" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource PanelFgDimBrush}" />
                        </StackPanel>
                    </Grid>

                    <StackPanel x:Name="TimelinePanel" Margin="0,14,0,0">
                        <Slider x:Name="Seek" Style="{StaticResource SeekSlider}" ValueChanged="Seek_ValueChanged"
                                LostMouseCapture="Seek_LostCapture" />
                        <Grid Margin="0,2,0,0">
                            <TextBlock x:Name="PositionText" FontSize="11" Foreground="{DynamicResource PanelFgDimBrush}" />
                            <TextBlock x:Name="DurationText" FontSize="11" HorizontalAlignment="Right" Foreground="{DynamicResource PanelFgDimBrush}" />
                        </Grid>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                        <Button x:Name="ShuffleButton" Style="{StaticResource PanelButton}" Width="36" Height="36" Margin="0,0,8,0"
                                Click="Shuffle_Click" ToolTip="Shuffle">
                            <Grid>
                                <TextBlock x:Name="ShuffleGlyph" Style="{StaticResource Glyph}" Text="&#xE8B1;" FontSize="14" />
                                <Ellipse x:Name="ShuffleDot" Width="4" Height="4" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Bottom"
                                         HorizontalAlignment="Center" Margin="0,0,0,-7" Visibility="Hidden" />
                            </Grid>
                        </Button>
                        <Button x:Name="FlyPrev" Style="{StaticResource PanelButton}" Width="40" Height="40" Click="Prev_Click" ToolTip="Previous">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE892;" FontSize="15" />
                        </Button>
                        <Button Width="46" Height="46" Margin="10,0" Click="Play_Click" Focusable="False" ToolTip="Play / Pause" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Grid>
                                        <Ellipse x:Name="Circle" Fill="{DynamicResource AccentBrush}" />
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Circle" Property="Opacity" Value="0.85" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <TextBlock x:Name="FlyPlayGlyph" Style="{StaticResource Glyph}" Text="&#xE768;" FontSize="17" Foreground="#111418" />
                        </Button>
                        <Button x:Name="FlyNext" Style="{StaticResource PanelButton}" Width="40" Height="40" Click="Next_Click" ToolTip="Next">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE893;" FontSize="15" />
                        </Button>
                        <Button x:Name="RepeatButton" Style="{StaticResource PanelButton}" Width="36" Height="36" Margin="8,0,0,0"
                                Click="Repeat_Click" ToolTip="Repeat">
                            <Grid>
                                <TextBlock x:Name="RepeatGlyph" Style="{StaticResource Glyph}" Text="&#xE8EE;" FontSize="14" />
                                <Ellipse x:Name="RepeatDot" Width="4" Height="4" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Bottom"
                                         HorizontalAlignment="Center" Margin="0,0,0,-7" Visibility="Hidden" />
                            </Grid>
                        </Button>
                    </StackPanel>

                    <!-- Volume dell'app che sta riproducendo (o di sistema, se l'app non è riconoscibile) -->
                    <DockPanel x:Name="VolumeRow" Margin="0,12,0,0">
                        <Button x:Name="MediaMuteButton" Style="{StaticResource PanelButton}" Padding="7" Click="MediaMute_Click" ToolTip="Mute">
                            <TextBlock x:Name="MediaMuteGlyph" Style="{StaticResource Glyph}" Text="&#xE995;" FontSize="14" />
                        </Button>
                        <TextBlock x:Name="MediaVolumeText" DockPanel.Dock="Right" Width="34" TextAlignment="Right" VerticalAlignment="Center"
                                   FontSize="12" Foreground="{DynamicResource PanelFgDimBrush}" />
                        <Slider x:Name="MediaVolume" Style="{StaticResource SeekSlider}" Minimum="0" Maximum="100" Margin="8,0,4,0"
                                VerticalAlignment="Center" ValueChanged="MediaVolume_ValueChanged" PreviewMouseWheel="MediaVolume_Wheel" />
                    </DockPanel>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
