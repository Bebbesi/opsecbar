<appbar:AppBarWindow x:Class="OpSecBar.Windows.TaskbarWindow"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:appbar="clr-namespace:ManagedShell.AppBar;assembly=ManagedShell.AppBar"
                     xmlns:c="clr-namespace:OpSecBar.Controls"
                     Title="OpSec Bar"
                     AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False" ShowActivated="False"
                     FontFamily="{DynamicResource BarFont}" FontSize="{DynamicResource BarFontSize}"
                     Foreground="{DynamicResource FgBrush}" SnapsToDevicePixels="True">
    <appbar:AppBarWindow.Resources>
        <!-- Icona di un'app (fissata e/o aperta): solo icona, nessuna etichetta -->
        <DataTemplate x:Key="TaskItemTemplate">
            <Grid x:Name="Root" Margin="{DynamicResource BarIconSpacing}" Background="Transparent" Opacity="0"
                  ToolTip="{Binding Title}" ToolTipService.InitialShowDelay="450"
                  PreviewMouseLeftButtonDown="Task_Down" MouseLeftButtonUp="Task_Up" MouseEnter="Task_Enter" MouseLeave="Task_Leave"
                  MouseRightButtonUp="Task_RightUp" MouseDown="Task_MouseDown"
                  DragEnter="Task_DragOver" DragOver="Task_DragOver" DragLeave="Task_DragLeave" Drop="Task_Drop">
                <Border x:Name="Hover" CornerRadius="7" Background="Transparent" />
                <Image x:Name="Icon" Source="{Binding Icon}" Width="{DynamicResource BarIconSize}" Height="{DynamicResource BarIconSize}"
                       Margin="7,4,7,6" RenderOptions.BitmapScalingMode="HighQuality" RenderTransformOrigin="0.5,0.5"
                       Opacity="{DynamicResource AppIconImageOpacity}"
                       VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Image.RenderTransform>
                        <ScaleTransform />
                    </Image.RenderTransform>
                </Image>
                <!-- Tinta delle icone (stile "Tinted"/"Monochrome"): rettangolo colorato con l'icona come maschera -->
                <Rectangle x:Name="Tint" Width="{DynamicResource BarIconSize}" Height="{DynamicResource BarIconSize}" Margin="7,4,7,6"
                           Fill="{DynamicResource AppIconTintBrush}" Opacity="{DynamicResource AppIconTintOpacity}"
                           Visibility="{DynamicResource AppIconTintVisibility}" IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5"
                           VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Rectangle.OpacityMask>
                        <ImageBrush ImageSource="{Binding Icon}" Stretch="Uniform" />
                    </Rectangle.OpacityMask>
                </Rectangle>
                <Border x:Name="Dot" Height="3" Width="0" CornerRadius="1.5" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                        Margin="0,0,0,1" Background="{DynamicResource FgDimBrush}" />
            </Grid>
            <DataTemplate.Triggers>
                <EventTrigger SourceName="Root" RoutedEvent="FrameworkElement.Loaded">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.18" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                    <Setter TargetName="Dot" Property="Width" Value="5" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsActive}" Value="True">
                    <Setter TargetName="Dot" Property="Width" Value="14" />
                    <Setter TargetName="Dot" Property="Background" Value="{DynamicResource AccentBrush}" />
                    <Setter TargetName="Hover" Property="Background" Value="{DynamicResource HoverBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsFlashing}" Value="True">
                    <Setter TargetName="Hover" Property="Background" Value="{DynamicResource AccentDimBrush}" />
                    <Setter TargetName="Dot" Property="Background" Value="{DynamicResource AccentBrush}" />
                </DataTrigger>
                <Trigger SourceName="Root" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Hover" Property="Background" Value="{DynamicResource PressedBrush}" />
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </appbar:AppBarWindow.Resources>

    <!-- Trascinamenti accettati su tutta la finestra (anche sul margine di una barra flottante, così in auto-hide
         la barra ricompare): file .gif sulla barra, qualsiasi file sull'icona di un'app. -->
    <Grid x:Name="RootGrid" AllowDrop="True" Drop="Bar_Drop" DragOver="Bar_DragOver">
        <!-- Ombra esterna (solo barra flottante senza blur) -->
        <Grid x:Name="ShadowLayer" IsHitTestVisible="False" Visibility="Collapsed">
            <Border x:Name="ShadowShape" Background="#000000">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="2" Direction="270" Opacity="0.5" />
                </Border.Effect>
            </Border>
        </Grid>

        <Border x:Name="BarBorder" MouseRightButtonUp="Bar_RightUp">
            <!-- Gli elementi della barra. Zona (sinistra / centro / destra) e ordine di ciascuno sono assegnati da codice
                 (ApplyWidgetLayout): disposizione classica oppure quella scelta nel layout avanzato. -->
            <c:BarPanel x:Name="WidgetPanel" Margin="6,0">
                <!-- Icone delle app: l'unico elemento flessibile, scorre quando lo spazio non basta -->
                <ScrollViewer x:Name="TasksScroll" c:BarPanel.Flex="True" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                              Focusable="False" PreviewMouseWheel="TasksScroll_Wheel">
                    <ItemsControl x:Name="TaskItems" ItemTemplate="{StaticResource TaskItemTemplate}" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="{Binding Orientation, RelativeSource={RelativeSource AncestorType=Window}}" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Player musicale (visibile solo durante la riproduzione) -->
                <c:MediaWidget x:Name="Media" HorizontalAlignment="Center" VerticalAlignment="Center" />

                <!-- GIF -->
                <StackPanel x:Name="GifHost" Orientation="Horizontal" VerticalAlignment="Center" />

                <!-- Info di sistema, volume, orologio, tray, impostazioni rapide, Start -->
                <TextBlock x:Name="SysInfoText" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="8,0"
                           Foreground="{DynamicResource FgDimBrush}" TextAlignment="Center" />

                <Button x:Name="VolumeButton" Style="{StaticResource BarButton}" Padding="7,0" Click="Volume_Click"
                        PreviewMouseWheel="Volume_Wheel" MouseRightButtonUp="Volume_RightUp" ToolTip="Volume">
                    <StackPanel x:Name="VolumePanel" Orientation="Horizontal">
                        <TextBlock x:Name="VolumeGlyph" Style="{StaticResource Glyph}" Text="&#xE995;" FontSize="14" Foreground="{DynamicResource IconBrush}" />
                        <TextBlock x:Name="VolumeText" Margin="5,0,0,0" VerticalAlignment="Center" TextAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button x:Name="ClockButton" Style="{StaticResource BarButton}" Click="Clock_Click"
                        ToolTip="Notifications and calendar">
                    <StackPanel x:Name="ClockPanel" Orientation="Horizontal">
                        <TextBlock x:Name="ClockDate" Foreground="{DynamicResource FgDimBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock x:Name="ClockTime" FontWeight="SemiBold" VerticalAlignment="Center" TextAlignment="Center" />
                    </StackPanel>
                </Button>

                <c:TrayArea x:Name="Tray" />

                <Button x:Name="QuickButton" Style="{StaticResource BarButton}" Padding="7,0" Click="Quick_Click"
                        ToolTip="Quick settings">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE9E9;" FontSize="14" Foreground="{DynamicResource IconBrush}" />
                </Button>

                <Button x:Name="StartButton" Style="{StaticResource BarButton}" Padding="8,0" Click="Start_Click"
                        MouseRightButtonUp="Start_RightUp" ToolTip="Start">
                    <!-- Logo proprio: quattro tessere arrotondate, una in colore d'accento -->
                    <Canvas Width="16" Height="16">
                        <Rectangle Width="7" Height="7" RadiusX="2" RadiusY="2" Fill="{DynamicResource AccentBrush}" />
                        <Rectangle Canvas.Left="9" Width="7" Height="7" RadiusX="2" RadiusY="2" Fill="{DynamicResource IconBrush}" />
                        <Rectangle Canvas.Top="9" Width="7" Height="7" RadiusX="2" RadiusY="2" Fill="{DynamicResource IconBrush}" />
                        <Rectangle Canvas.Left="9" Canvas.Top="9" Width="7" Height="7" RadiusX="3.5" RadiusY="3.5" Fill="{DynamicResource IconBrush}" />
                    </Canvas>
                </Button>
            </c:BarPanel>
        </Border>

        <!-- Bordo animato (minimal o divertente): sopra la barra, non intercetta il mouse -->
        <c:BorderFxLayer x:Name="FxLayer" />

        <Popup x:Name="VolumeFlyout" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade"
               PlacementTarget="{Binding ElementName=VolumeButton}" Opened="VolumeFlyout_Opened" Closed="VolumeFlyout_Closed">
            <Border Style="{StaticResource FlyoutBorder}" Padding="10,8" AllowDrop="False" TextElement.Foreground="{DynamicResource PanelFgBrush}"
                    TextElement.FontFamily="{DynamicResource BarFont}">
                <StackPanel Width="250">
                    <DockPanel>
                        <Button x:Name="MuteButton" Style="{StaticResource PanelButton}" Padding="8" Click="Mute_Click" ToolTip="Mute">
                            <TextBlock x:Name="MuteGlyph" Style="{StaticResource Glyph}" Text="&#xE995;" FontSize="16" />
                        </Button>
                        <TextBlock x:Name="VolumeValue" DockPanel.Dock="Right" Width="38" TextAlignment="Right" VerticalAlignment="Center" FontSize="13" />
                        <Slider x:Name="VolumeSlider" Style="{StaticResource SeekSlider}" Minimum="0" Maximum="100" Margin="8,0,4,0"
                                VerticalAlignment="Center" ValueChanged="VolumeSlider_ValueChanged" />
                    </DockPanel>
                    <Button Style="{StaticResource PanelButton}" Padding="8,6" Margin="0,4,0,0" HorizontalAlignment="Left" Click="SoundSettings_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE713;" FontSize="13" Margin="0,0,8,0" />
                            <TextBlock Text="Sound settings" FontSize="12.5" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</appbar:AppBarWindow>
