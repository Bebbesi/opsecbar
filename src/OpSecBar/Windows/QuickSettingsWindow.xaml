<local:FlyoutWindow x:Class="OpSecBar.Windows.QuickSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:OpSecBar.Windows"
        Title="Open TaskBar Quick settings" Width="396" SizeToContent="Height">
    <local:FlyoutWindow.Resources>
        <!-- Tessera: riempita in colore d'accento quando è attiva (lo decide il codice), velata al passaggio del mouse.
             Tag = raggio degli angoli, così le due metà di una tessera doppia si arrotondano solo all'esterno. -->
        <Style x:Key="TileButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource PanelFgBrush}" />
            <Setter Property="Background" Value="{DynamicResource PanelHoverBrush}" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Height" Value="48" />
            <Setter Property="Tag">
                <Setter.Value>
                    <CornerRadius>8</CornerRadius>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border Background="{TemplateBinding Background}" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1"
                                    CornerRadius="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />
                            <Border x:Name="Hover" Background="{DynamicResource PanelPressedBrush}" Opacity="0"
                                    CornerRadius="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />
                            <ContentPresenter />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Hover" Property="Opacity" Value="0.6" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Hover" Property="Opacity" Value="1" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Riga di un elenco (rete Wi-Fi, dispositivo Bluetooth) -->
        <Style x:Key="RowButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource PanelFgBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="10,8">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PanelHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PanelPressedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </local:FlyoutWindow.Resources>

    <Grid Margin="14">
        <!-- Sfondo + ombra separati dal contenuto, così il testo resta nitido -->
        <Border CornerRadius="14" Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="4" Direction="270" Opacity="0.4" />
            </Border.Effect>
        </Border>

        <StackPanel x:Name="MainPage" Margin="16,18,16,10">
            <!-- Tessere (create da codice) -->
            <UniformGrid x:Name="Tiles" Columns="3" />

            <Border Height="1" Margin="0,2,0,12" Background="{DynamicResource PanelBorderBrush}" />

            <!-- Volume e dispositivo di uscita -->
            <DockPanel Margin="2,0" Background="Transparent" MouseWheel="Volume_MouseWheel">
                <Button x:Name="MuteButton" Style="{StaticResource PanelButton}" Width="34" Height="34" Click="Mute_Click" ToolTip="Mute">
                    <TextBlock x:Name="MuteGlyph" Style="{StaticResource Glyph}" Text="&#xE995;" FontSize="16" />
                </Button>
                <Button x:Name="OutputButton" DockPanel.Dock="Right" Style="{StaticResource PanelButton}" Height="34" Padding="9,0"
                        Click="Output_Click" MouseRightButtonUp="Output_RightClick" ToolTip="Sound output and app volume">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE7F5;" FontSize="15" />
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE76C;" FontSize="9" Margin="6,1,0,0" />
                    </StackPanel>
                </Button>
                <TextBlock x:Name="VolumeValue" DockPanel.Dock="Right" Width="30" TextAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0" />
                <Slider x:Name="VolumeSlider" Style="{StaticResource SeekSlider}" Minimum="0" Maximum="100" Margin="8,0,4,0"
                        VerticalAlignment="Center" ValueChanged="VolumeSlider_ValueChanged" />
            </DockPanel>

            <!-- Piede: batteria (se c'è) e Impostazioni di Windows -->
            <Border Margin="0,12,0,0" Padding="0,8,0,0" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="0,1,0,0">
                <Grid>
                    <StackPanel x:Name="BatteryPanel" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0" Visibility="Collapsed">
                        <TextBlock x:Name="BatteryGlyph" Style="{StaticResource Glyph}" FontSize="16" />
                        <TextBlock x:Name="BatteryText" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="12.5" />
                    </StackPanel>
                    <Button Style="{StaticResource PanelButton}" Width="34" Height="34" HorizontalAlignment="Right" Click="Settings_Click"
                            ToolTip="Windows Settings">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE713;" FontSize="15" />
                    </Button>
                </Grid>
            </Border>
        </StackPanel>

        <!-- Pagina secondaria: reti Wi-Fi oppure dispositivi Bluetooth (righe create da codice) -->
        <StackPanel x:Name="SubPage" Margin="12,12,12,10" Visibility="Collapsed">
            <DockPanel Margin="0,0,0,8">
                <Button Style="{StaticResource PanelButton}" Width="32" Height="32" Click="Back_Click" ToolTip="Back">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE72B;" FontSize="12" />
                </Button>
                <Button x:Name="SubSwitch" DockPanel.Dock="Right" Style="{StaticResource TileButton}" Width="54" Height="28" Margin="6,0,4,0"
                        Click="SubSwitch_Click" />
                <Button x:Name="SubRefresh" DockPanel.Dock="Right" Style="{StaticResource PanelButton}" Width="32" Height="32"
                        Click="SubRefresh_Click" ToolTip="Search again">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE72C;" FontSize="13" />
                </Button>
                <TextBlock x:Name="SubTitle" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" Margin="8,0,0,0" />
            </DockPanel>

            <ScrollViewer Height="300" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                <StackPanel x:Name="SubList" Margin="0,0,2,0" />
            </ScrollViewer>

            <Border Margin="0,8,0,0" Padding="0,8,0,0" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="0,1,0,0">
                <Button Style="{StaticResource PanelButton}" Padding="8,6" HorizontalAlignment="Left" Click="SubMore_Click">
                    <TextBlock x:Name="SubMoreText" FontSize="12.5" />
                </Button>
            </Border>
        </StackPanel>
    </Grid>
</local:FlyoutWindow>
