<local:FlyoutWindow x:Class="OpSecBar.Windows.CalendarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:OpSecBar.Windows"
        Title="Open TaskBar Calendar" Width="368" SizeToContent="Height">
    <local:FlyoutWindow.Resources>
        <!-- Giorno del mese: cerchio che si riempie (oggi), si contorna (giorno scelto) o si vela (mouse sopra) -->
        <Style x:Key="DayButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource PanelFgBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1.5" CornerRadius="18" />
                            <Border x:Name="Hover" CornerRadius="18" Background="{DynamicResource PanelPressedBrush}" Opacity="0" />
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Hover" Property="Opacity" Value="0.7" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Hover" Property="Opacity" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </local:FlyoutWindow.Resources>

    <Grid Margin="14">
        <!-- Sfondo + ombra separati dal contenuto, così il testo resta nitido -->
        <Border CornerRadius="14" Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="4" Direction="270" Opacity="0.4" />
            </Border.Effect>
        </Border>

        <StackPanel Margin="16,14,16,12">
            <!-- Adesso -->
            <TextBlock x:Name="TimeText" FontSize="30" FontWeight="SemiBold" Margin="6,0,0,0" />
            <TextBlock x:Name="DateText" Margin="6,2,0,0" Foreground="{DynamicResource PanelFgDimBrush}" />

            <Border Height="1" Margin="0,14,0,10" Background="{DynamicResource PanelBorderBrush}" />

            <!-- Mese mostrato -->
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Style="{StaticResource PanelButton}" Width="32" Height="32" Click="Previous_Click" ToolTip="Previous month">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE70E;" FontSize="12" />
                    </Button>
                    <Button Style="{StaticResource PanelButton}" Width="32" Height="32" Margin="2,0,0,0" Click="Next_Click" ToolTip="Next month">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE70D;" FontSize="12" />
                    </Button>
                </StackPanel>
                <Button Style="{StaticResource PanelButton}" Padding="8,6" HorizontalAlignment="Left" Click="Today_Click" ToolTip="Back to today">
                    <TextBlock x:Name="MonthText" FontWeight="SemiBold" FontSize="14" />
                </Button>
            </DockPanel>

            <UniformGrid x:Name="WeekdayRow" Columns="7" Margin="0,8,0,2" />
            <UniformGrid x:Name="DayGrid" Columns="7" Rows="6" Background="Transparent" MouseWheel="DayGrid_MouseWheel" />

            <TextBlock x:Name="DetailText" Margin="6,8,0,0" FontSize="12" Foreground="{DynamicResource PanelFgDimBrush}"
                       TextTrimming="CharacterEllipsis" />

            <!-- Piede: notifiche di Windows, impostazioni di data e ora -->
            <Border Margin="0,12,0,0" Padding="0,8,0,0" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="0,1,0,0">
                <Grid>
                    <Button Style="{StaticResource PanelButton}" Padding="8,6" HorizontalAlignment="Left" Click="Notifications_Click"
                            ToolTip="Open the Windows notification panel">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xEA8F;" FontSize="14" Margin="0,0,8,0" />
                            <TextBlock Text="Notifications" FontSize="12.5" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource PanelButton}" Width="34" Height="34" HorizontalAlignment="Right" Click="DateSettings_Click"
                            ToolTip="Date and time settings">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE713;" FontSize="15" />
                    </Button>
                </Grid>
            </Border>
        </StackPanel>
    </Grid>
</local:FlyoutWindow>
