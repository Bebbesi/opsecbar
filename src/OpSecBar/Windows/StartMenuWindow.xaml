<Window x:Class="OpSecBar.Windows.StartMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OpSec Bar Start" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize" WindowStartupLocation="Manual"
        FontFamily="{DynamicResource BarFont}" FontSize="13" Foreground="{DynamicResource PanelFgBrush}"
        Deactivated="Window_Deactivated" PreviewKeyDown="Window_PreviewKeyDown" SnapsToDevicePixels="True">
    <Window.Resources>
        <!-- Riga dell'elenco "All apps" -->
        <DataTemplate x:Key="AppRowTemplate">
            <StackPanel Orientation="Horizontal" Height="36">
                <Image Source="{Binding Icon}" Width="24" Height="24" Margin="8,0,12,0" RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </DataTemplate>

        <Style x:Key="AppRowContainer" TargetType="ListBoxItem">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Foreground" Value="{DynamicResource PanelFgBrush}" />
            <EventSetter Event="PreviewMouseLeftButtonUp" Handler="AppRow_Click" />
            <EventSetter Event="MouseRightButtonUp" Handler="AppRow_RightClick" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="7" Margin="0,1">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PanelHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PanelPressedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tessera dei preferiti -->
        <DataTemplate x:Key="FavoriteTemplate">
            <Button Style="{StaticResource PanelButton}" Width="88" Height="78" Margin="2" Padding="4"
                    Click="Favorite_Click" MouseRightButtonUp="Favorite_RightClick" ToolTip="{Binding Name}">
                <StackPanel>
                    <Image Source="{Binding Icon}" Width="30" Height="30" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="{Binding Name}" FontSize="11.5" Margin="0,7,0,0" TextAlignment="Center" MaxWidth="80"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Button>
        </DataTemplate>
    </Window.Resources>

    <Grid x:Name="RootGrid" Margin="14" RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="Slide" />
        </Grid.RenderTransform>

        <!-- Sfondo + ombra separati dal contenuto, così il testo resta nitido -->
        <Border x:Name="Backplate" CornerRadius="14" Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect x:Name="PanelShadow" BlurRadius="18" ShadowDepth="4" Direction="270" Opacity="0.4" />
            </Border.Effect>
        </Border>

        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Ricerca -->
            <Border CornerRadius="9" Background="{DynamicResource PanelHoverBrush}" Height="38" Padding="12,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE721;" FontSize="13" Foreground="{DynamicResource PanelFgDimBrush}" />
                    <TextBlock x:Name="SearchHint" Grid.Column="1" Text="Search apps" Margin="12,0,0,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource PanelFgDimBrush}" IsHitTestVisible="False" />
                    <TextBox x:Name="SearchBox" Grid.Column="1" Margin="10,0,0,0" Background="Transparent" BorderThickness="0"
                             Foreground="{DynamicResource PanelFgBrush}" CaretBrush="{DynamicResource PanelFgBrush}"
                             VerticalContentAlignment="Center" TextChanged="SearchBox_TextChanged" />
                </Grid>
            </Border>

            <!-- Preferiti -->
            <StackPanel x:Name="FavoritesSection" Grid.Row="1" Margin="0,14,0,0">
                <TextBlock Text="Favorites" FontWeight="SemiBold" Margin="4,0,0,6" />
                <ItemsControl x:Name="FavoritesList" ItemTemplate="{StaticResource FavoriteTemplate}" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
                <TextBlock x:Name="FavoritesHint" TextWrapping="Wrap" Margin="4,2,0,0" FontSize="12"
                           Foreground="{DynamicResource PanelFgDimBrush}"
                           Text="Right-click an app below to add it to your favorites." />
            </StackPanel>

            <!-- Tutte le app / risultati -->
            <Grid Grid.Row="2" Margin="0,14,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock x:Name="ListHeader" Text="All apps" FontWeight="SemiBold" Margin="4,0,0,6" />
                <ListBox x:Name="AppList" Grid.Row="1" Background="Transparent" BorderThickness="0"
                         ItemTemplate="{StaticResource AppRowTemplate}" ItemContainerStyle="{StaticResource AppRowContainer}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.ScrollUnit="Pixel"
                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" />
                <TextBlock x:Name="EmptyText" Grid.Row="1" Text="Loading apps…" HorizontalAlignment="Center" Margin="0,30,0,0"
                           Foreground="{DynamicResource PanelFgDimBrush}" />
            </Grid>

            <!-- Piede: utente, impostazioni, alimentazione -->
            <Border Grid.Row="3" Margin="0,12,0,0" Padding="0,10,0,0" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="0,1,0,0">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,0,0">
                        <Border Width="28" Height="28" CornerRadius="14" Background="{DynamicResource AccentDimBrush}">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE77B;" FontSize="13" />
                        </Border>
                        <TextBlock x:Name="UserName" Margin="10,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource PanelButton}" Width="36" Height="36" Click="Settings_Click" ToolTip="OpSec Bar settings">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE713;" FontSize="15" />
                        </Button>
                        <Button x:Name="PowerButton" Style="{StaticResource PanelButton}" Width="36" Height="36" Margin="4,0,0,0"
                                Click="Power_Click" ToolTip="Power">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE7E8;" FontSize="15" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
